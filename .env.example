# Copia este archivo como .env.local para trabajar en local.
# En Render, define estas mismas variables en el panel del servicio
# (Environment > Environment Variables). Nunca hagas commit de valores reales.

# Dominio publico del sitio. Se usa en canonical/SEO y en enlaces absolutos.
SITE_URL=https://polleria-don-pepito.onrender.com

# Supabase (opcional). Si se omiten, la app compila en modo demo sin claves.
# Nunca uses aqui la service_role key: esta app es 100% frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# true = datos locales de demostracion; false = consulta Supabase.
USE_DEMO_FALLBACK=true

# Cuentas de demostracion del modo demo (no son cuentas reales).
DEMO_ADMIN_EMAIL=admin@donpepito.pe
DEMO_ADMIN_PASSWORD=admin123
DEMO_CLIENT_EMAIL=cliente@demo.pe
DEMO_CLIENT_PASSWORD=demo1234
